# Maintainer: Anwar Ahmed <anwar dot ahmed at gmail dot com>
#
# Generated by packaging/aur/render.sh in https://github.com/anwarahmed/funwordl
# for each release; edit the template there, not this file.

pkgname=funwordl-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="A playful Wordle-style word game for the terminal, made for children"
arch=('x86_64' 'aarch64')
url="https://github.com/anwarahmed/funwordl"
license=('MIT' 'LicenseRef-SCOWL')
provides=('funwordl')
conflicts=('funwordl')
# The binaries are static and already stripped of debug info.
options=('!strip' '!debug')
source=("funwordl-$pkgver-LICENSE::https://raw.githubusercontent.com/anwarahmed/funwordl/v$pkgver/LICENSE"
        "funwordl-$pkgver-SCOWL-COPYRIGHT::https://raw.githubusercontent.com/anwarahmed/funwordl/v$pkgver/SCOWL-COPYRIGHT")
source_x86_64=("funwordl-$pkgver-x86_64::$url/releases/download/v$pkgver/funwordl-x86_64-unknown-linux-musl")
source_aarch64=("funwordl-$pkgver-aarch64::$url/releases/download/v$pkgver/funwordl-aarch64-unknown-linux-musl")
sha256sums=('@SHA_LICENSE@'
            '@SHA_SCOWL@')
sha256sums_x86_64=('@SHA_X86_64@')
sha256sums_aarch64=('@SHA_AARCH64@')

package() {
    install -Dm755 "$srcdir/funwordl-$pkgver-$CARCH" "$pkgdir/usr/bin/funwordl"
    install -Dm644 "$srcdir/funwordl-$pkgver-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    # The word lists inside the binary are derived from SCOWL, which asks for its notice.
    install -Dm644 "$srcdir/funwordl-$pkgver-SCOWL-COPYRIGHT" "$pkgdir/usr/share/licenses/$pkgname/SCOWL-COPYRIGHT"
    # pacman owns this copy: the marker tells the game never to update itself. It looks
    # for it at ../share/funwordl/managed-by from the directory of its binary.
    install -d "$pkgdir/usr/share/funwordl"
    echo "pacman; update the funwordl-bin package" > "$pkgdir/usr/share/funwordl/managed-by"
}
